        "kind": "case",
        "condition": null,
        "attribution": "本段作者"
      },
      "spans": [
        {
          "start": 429,
          "end": 528,
          "quote": "又如盤十一的女命，走到壬寅限，武曲化忌在大限福德辰宮，在論及寅辰二宮的互動時，由於辰宮的武曲已經化忌，致使寅宮火星對武曲產生火剋金的剋害作用，故壬寅限的福德宮之武曲就會因大限寅宮有火星而變得非常凶。"
        }
      ],
      "basis": "source",
